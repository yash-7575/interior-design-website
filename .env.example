# Sanity — the CMS MegaDream use to add projects.
# Both values are public identifiers, not secrets: they appear in the requests
# the browser makes. Get them from https://manage.sanity.io after creating the
# project. Leave them unset and the site falls back to the ten projects bundled
# in src/data/projects.ts.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
