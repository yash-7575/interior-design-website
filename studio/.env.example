# Copy to studio/.env and fill in from https://manage.sanity.io
# None of these are secrets — the project id is public and appears in the
# website's own requests. Do not put an API token in here.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional. The subdomain used by `npx sanity deploy`, giving you
# https://<hostname>.sanity.studio — e.g. SANITY_STUDIO_HOSTNAME=megadream
SANITY_STUDIO_HOSTNAME=
